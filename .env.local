# Firebase - DEVELOPMENT EMULATOR CONFIG
NEXT_PUBLIC_FIREBASE_API_KEY=demo-avalia-gestao-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-avalia-gestao.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-avalia-gestao
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-avalia-gestao.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789000
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789000:web:demoavaliaapp

# Firebase Admin SDK - Emulator uses no real credentials
FIREBASE_ADMIN_PROJECT_ID=demo-avalia-gestao
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Application
NEXTAUTH_SECRET=dev-secret-key-change-in-production-minimum-32-chars
NEXT_PUBLIC_APP_URL=http://10.66.34.152:3000
NEXT_PUBLIC_APP_NAME=AvaliaGestão

# Firebase Emulator
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT=8080
NEXT_PUBLIC_AUTH_EMULATOR_HOST=10.66.34.152
NEXT_PUBLIC_AUTH_EMULATOR_PORT=9099

# Security
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_MS=60000
MAX_COMMENT_LENGTH=1000
MIN_EVALUATIONS_FOR_DISPLAY=5
FIREBASE_AUTH_EMULATOR_HOST=10.66.34.152:9099
