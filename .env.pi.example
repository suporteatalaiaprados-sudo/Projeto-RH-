# Copie para .env.pi no Raspberry e preencha os dados do projeto Firebase.
# Nunca versione .env.pi nem compartilhe a chave privada do Admin SDK.

# IP reservado do Raspberry; a aplicação só publicará a porta nesta interface.
SITE_BIND_IP=10.66.10.98
# Porta de acesso HTTP do AvaliaGestão; o GestaoVista continua na porta 80.
SITE_APP_PORT=8081

# URL que os dispositivos da produção usarão. HTTP não criptografa a conexão.
NEXT_PUBLIC_APP_URL=http://10.66.10.98:8081
NEXT_PUBLIC_APP_NAME=AvaliaGestão

# Firebase Web config (pública; usada pelo SDK no navegador durante o build).
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyD3WK8iAter8HgP_q-or8O87w1JGTkNJNY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=avaliagestao-rh-prd-2026.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=avaliagestao-rh-prd-2026
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=avaliagestao-rh-prd-2026.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=442797508458
NEXT_PUBLIC_FIREBASE_APP_ID=1:442797508458:web:a88cc20d0ddbb1c9998713
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# Firebase Admin SDK (privado; usado somente no servidor).
FIREBASE_ADMIN_PROJECT_ID=avaliagestao-rh-prd-2026
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCOLE_A_CHAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"

# Regras funcionais do sistema.
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=60000
MAX_COMMENT_LENGTH=1000
MIN_EVALUATIONS_FOR_DISPLAY=5


